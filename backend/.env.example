# Backend Server Port
PORT=5000

# Google Maps / Routes API Key (KEEP SECRET! NEVER EXPOSE TO FRONTEND)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Office Coordinates and Details: สำนักงานใหญ่ SCG (บริษัท ปูนซิเมนต์ไทย จำกัด (มหาชน)) บางซื่อ
OFFICE_NAME=สำนักงานใหญ่ SCG (บริษัท ปูนซิเมนต์ไทย จำกัด (มหาชน))
OFFICE_LAT=13.806490
OFFICE_LNG=100.538290

# Allowed Frontend Origins for CORS (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080
